+# Experimental same-process queue. Acoustic B=1; max_num_seqs limits AR only.
+# Keep the upstream sampler, condition prefill, NAR/velocity graphs and VAE.
+# This 4GiB AR cache budget is the tested 3090 setting, not a memory guarantee.
+pipeline: yue2_queue
+model_runner: v1
+async_chunk: false
+dtype: bfloat16
+stages:
+- stage_id: 0
+  max_num_seqs: 4
+  gpu_memory_utilization: 0.7
+  enforce_eager: false
+  enable_prefix_caching: false
+  max_num_batched_tokens: 24576
+  max_model_len: 24576
+  devices: '0'
+  skip_tokenizer_init: true
+  tokenizer: gpt2
+  hf_overrides:
+    architectures:
+    - Yue2QueuedModel
+    yue2_vae_path: null
+    yue2_vae_revision: main
+  default_sampling_params:
+    extra_args:
+      yue2_phase: semantic
+      yue2_seed: 831001
+      yue2_max_audio_frames: 200
+      yue2_max_hold_steps: 4096
+    detokenize: false
+    stop_token_ids:
+    - 151848
+    - 151852
+    max_tokens: 4297
+    temperature: 1.0
+  async_scheduling: false
+  enable_chunked_prefill: false
+  compilation_config:
+    mode: 3
+    cudagraph_mode: FULL_AND_PIECEWISE
+    cudagraph_capture_sizes:
+    - 1
+    - 2
+    - 4
+  kv_cache_memory_bytes: 4294967296
+  worker_cls: vllm_omni.model_executor.models.yue2.queued.Yue2QueueWorker
