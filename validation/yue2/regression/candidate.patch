+    )
+    queue = BatchedSynthesisQueue(None, 4, 1, 1024, batch_max_tokens=100)
+    queue.submit(state)
+    chunks = yue2.song_chunks(state.prefix_ids, [0] * frames, 17)
+    assert state.acoustic_batch_tokens == max(len(c.ar_tokens) + len(c.noise) + 2 for c in chunks)
